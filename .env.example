# Use a RESTORED STAGING database first, never the live database for preview.
# Optional for `pnpm dev` without any DB settings: LOCAL_PREVIEW=1.
# This never applies in production or when database settings are present.
LOCAL_PREVIEW=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shivpatel_staging
DB_USER=shivpatel_app
DB_PASSWORD=
DB_SSL=true
# Optional PEM CA certificate; use literal \n for newlines.
DB_SSL_CA=
ADMIN_EMAIL=
# Generate a random 32+ character key. Server only; never NEXT_PUBLIC_.
RATE_LIMIT_SECRET=
# Keep 1 until backup, reconciliation and staging acceptance are complete.
MIGRATION_READ_ONLY=1
APP_ORIGIN=http://localhost:3000
# Durable public media root for existing relative poster/gallery paths.
# Example: https://media.example.com/storage/ (must end with /)
MEDIA_BASE_URL=
# Optional new media uploads to Vercel Blob (public store).
BLOB_READ_WRITE_TOKEN=
# Optional notifications. SMTP_FROM and LEAD_RECIPIENT must be verified/configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEAD_RECIPIENT=
# Protects /api/jobs/notifications; configure Vercel Cron or external scheduler.
CRON_SECRET=
