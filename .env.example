# Use a RESTORED STAGING database first, never the live database for preview.
# Optional for `pnpm dev` without any DB settings: LOCAL_PREVIEW=1.
# This never applies in production or when database settings are present.
LOCAL_PREVIEW=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shivpatel_staging
DB_USER=shivpatel_app
DB_PASSWORD=
DB_SSL=true
# Optional PEM CA certificate; use literal \n for newlines.
DB_SSL_CA=
ADMIN_EMAIL=
# Generate a random 32+ character key. Server only; never NEXT_PUBLIC_.
RATE_LIMIT_SECRET=
# Keep 1 until backup, reconciliation and staging acceptance are complete.
MIGRATION_READ_ONLY=1
APP_ORIGIN=http://localhost:3000
# Durable public media root for existing relative poster/gallery paths.
# Example: https://media.example.com/storage/ (must end with /)
MEDIA_BASE_URL=
# Optional new media uploads to Vercel Blob (public store).
BLOB_READ_WRITE_TOKEN=
# Optional notifications. SMTP_FROM and LEAD_RECIPIENT must be verified/configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEAD_RECIPIENT=
# Protects /api/jobs/notifications; configure Vercel Cron or external scheduler.
CRON_SECRET=
# Server-only draft ingestion credential; the worker cannot approve or publish.
PROJECT_AUTOMATION_KEY=
PROJECT_GITHUB_OWNER=ShivPatel412
# Explicitly permit authenticated project ingestion to publish after a real screenshot.
# Keep 0 until production storage, database migration and worker have been verified.
PROJECT_AUTOMATION_AUTO_PUBLISH=0
# Optional local master dashboard integrations (pnpm dev:master).
# Point to the existing collector's sanitized snapshot, or copy it to .local/control-room/snapshot.json.
CONTROL_ROOM_SNAPSHOT_PATH=
# Optional read access to the existing loopback photo worker. Server only.
PHOTO_WORKER_TOKEN=

# Instagram Studio. Use a PRIVATE Blob store, separate from public project media.
STUDIO_BLOB_READ_WRITE_TOKEN=
STUDIO_UPLOAD_BYTES=4000000
# New authenticated execution webhook; never reuse CONTROL_ROOM_PUSH_KEY.
STUDIO_N8N_WEBHOOK_URL=
STUDIO_N8N_WEBHOOK_KEY=
STUDIO_CALLBACK_KEY=
STUDIO_DISPATCH_KEY=
# Public Google app identifiers, never an OAuth client secret.
NEXT_PUBLIC_STUDIO_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_STUDIO_GOOGLE_PICKER_KEY=
NEXT_PUBLIC_STUDIO_GOOGLE_APP_ID=
